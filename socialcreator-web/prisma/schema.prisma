generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth required ────────────────────────────────────────

// Role enum
enum Role {
  USER
  ADMIN
}

model User {
  id                       String             @id @default(cuid())
  name                     String?
  email                    String             @unique
  emailVerified            DateTime?
  image                    String?
  password                 String? // For credentials auth (optional, OAuth users don't have password)
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripeSubscriptionStatus String?
  cguAccepted              Boolean            @default(false)
  cguAcceptedAt            DateTime?
  ownedTeams               Team[]             @relation("TeamOwner")
  teamMemberships          TeamMember[]
  accounts                 Account[]
  sessions                 Session[]
  profiles                 Profile[]
  apiKeys                  ApiKey[]
  publishLogs              PublishLog[]
  invitationsSent          Invitation[]       @relation("InvitedBy")
  notifications            Notification[]
  reviewedContent          GeneratedContent[] @relation("ContentReviewer")
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  role                     Role               @default(USER)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Application ─────────────────────────────────────────────

// ── Team Collaboration ─────────────────────────────────────

model Team {
  id           String        @id @default(cuid())
  name         String
  ownerId      String
  owner        User          @relation("TeamOwner", fields: [ownerId], references: [id])
  members      TeamMember[]
  invitations  Invitation[]
  profiles     Profile[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organization Organization?

  @@index([ownerId])
}

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContentReviewStatus {
  NONE
  IN_REVIEW
  APPROVED
  REJECTED
}

model TeamMember {
  id        String    @id @default(cuid())
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole  @default(VIEWER)
  invitedAt DateTime  @default(now())
  joinedAt  DateTime?

  @@unique([teamId, userId])
  @@index([userId])
}

// ── Invitations ───────────────────────────────────────

model Invitation {
  id              String           @id @default(cuid())
  teamId          String
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedByUserId String
  invitedBy       User             @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  email           String
  role            TeamRole         @default(VIEWER)
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@index([teamId])
  @@index([email])
  @@index([token])
  @@index([status, expiresAt])
}

// ── Notifications ─────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String?
  data      Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

// ── Media Library ─────────────────────────────────────────

model MediaAsset {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type       MediaType
  url        String    @db.Text
  filename   String?
  mimeType   String?
  size       Int?
  width      Int?
  height     Int?
  duration   Float? // For video/audio
  uploadedAt DateTime  @default(now())

  @@index([profileId])
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

model Profile {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId            String?
  team              Team?              @relation(fields: [teamId], references: [id])
  name              String
  brandVoice        String             @db.Text
  contentBank       String?            @db.Text
  platforms         Platform[]
  avatarUrl         String?
  isActive          Boolean            @default(true)
  connectedAccounts ConnectedAccount[]
  agents            Agent[]
  analytics         Analytics[]
  generatedContents GeneratedContent[]
  mediaAssets       MediaAsset[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  videoAssets       VideoAsset[]

  @@index([teamId])
}

model ConnectedAccount {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform  Platform

  /// Access token stocké chiffré via AES-256 (cf. src/lib/crypto.ts)
  /// L'encrypt/decrypt est géré côté application via getValidAccessToken()
  accessToken String @db.Text

  /// Refresh token stocké chiffré via AES-256
  /// Utilisé pour automatiquement renouveler l'access token avant expiration
  refreshToken String? @db.Text

  /// Date d'expiration de l'access token
  /// Si expiré, le système tente automatiquement un refresh via refreshToken
  expiresAt DateTime?

  /// ID du compte sur la plateforme (ex: Instagram Business Account ID)
  accountId String

  /// Nom du compte (ex: @username)
  accountName String

  /// URL de l'avatar du compte
  accountAvatarUrl String?

  /// Indique si le compte est actif pour la publication
  /// Un compte peut être désactivé sans être supprimé (pour révocation de permissions)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, platform])
}

enum Platform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  FACEBOOK
  X
  LINKEDIN
  THREADS
  PINTEREST
}

model Agent {
  id           String     @id @default(cuid())
  profileId    String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  type         AgentType
  platforms    Platform[]
  scheduleCron String?
  isActive     Boolean    @default(false)
  autoPublish  Boolean    @default(false)
  maxPerDay    Int        @default(2)
  config       Json       @default("{}")
  runs         AgentRun[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([profileId])
}

enum AgentType {
  TEXT_POST
  VIDEO_CLIP
  CROSS_POST
}

model AgentRun {
  id                String             @id @default(cuid())
  agentId           String
  agent             Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  brief             String             @db.Text
  status            RunStatus          @default(PENDING)
  startedAt         DateTime?
  finishedAt        DateTime?
  error             String?
  generatedContents GeneratedContent[]
  createdAt         DateTime           @default(now())

  @@index([agentId])
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

model GeneratedContent {
  id                 String              @id @default(cuid())
  runId              String?
  run                AgentRun?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  profileId          String
  profile            Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform           Platform
  textContent        String              @db.Text
  mediaUrls          String[]
  hashtags           String[]
  status             ContentStatus       @default(DRAFT)
  reviewStatus       ContentReviewStatus @default(NONE)
  reviewedById       String?
  reviewedBy         User?               @relation("ContentReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  reviewComment      String?             @db.Text
  postId             String?
  publishedAt        DateTime?
  rejectedAt         DateTime?
  scheduledPublishAt DateTime? // Publication planifiée
  scheduledTimezone  String?             @default("UTC")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, scheduledPublishAt])
  @@index([profileId, status])
  @@index([reviewStatus])
}

enum ContentStatus {
  DRAFT
  APPROVED
  PUBLISHED
  FAILED
  REJECTED
  SCHEDULED // En attente de publication planifiée
  PUBLISHING // En cours de publication (verrou atomique)
}

/// Journal d'audit immuable pour chaque publication
/// Aucune mise à jour possible - uniquement des lectures et insertions
/// Utilisé pour vérifier les caps quotidiens et pour l'audit de conformité
model PublishLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String
  platform  Platform
  contentId String

  /// Hash SHA-256 du contenu publié - permet détection de doublons
  contentHash String

  /// Indique si la publication a réussi
  success Boolean

  /// Message d'erreur si échec (null si succès)
  error String?

  publishedAt DateTime @default(now())

  @@unique([contentHash, profileId, success])
  @@index([userId, publishedAt])
  @@index([profileId, publishedAt])
  @@index([contentHash, profileId, success])
}

model ApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nom arbitraire pour identifier la clé (ex: "Production API Key")
  name String

  /// Hash SHA-256 de la clé API - JAMAIS stocké en clair
  /// Pour valider: hash(input) === keyHash
  keyHash String @unique

  /// Préfixe pour identifier le type de clé (ex: "sc_live_" ou "sc_test_")
  /// Permet d'afficher un préfixe à l'utilisateur sans révéler la clé complète
  prefix String

  /// Dernière utilisation de la clé
  lastUsed DateTime?

  /// Date de révocation (si non null, la clé ne fonctionne plus)
  revokedAt DateTime?

  /// Date d'expiration automatique (si non null, la clé expire à cette date)
  expiresAt DateTime?

  createdAt DateTime @default(now())
}

model Analytics {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date        DateTime @default(now()) @db.Date
  platform    Platform
  impressions Int      @default(0)
  engagements Int      @default(0)
  clicks      Int      @default(0)
  followers   Int      @default(0)

  @@unique([profileId, date, platform])
  @@index([profileId, date])
}

model VideoAsset {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  uploadUrl     String   @db.Text
  muxAssetId    String?  @unique
  muxPlaybackId String?
  transcript    String?  @db.Text
  segments      Json?
  status        String   @default("UPLOADING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([profileId])
}

// ============================================
// Feature Flags & Entitlements System
// ============================================

model Plan {
  id           String        @id @default(cuid())
  key          String        @unique // "free", "starter", "pro", "team"
  name         String
  priceMonthly Int           @default(0) // cents
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  planFeatures PlanFeature[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Feature {
  id            String        @id @default(cuid())
  key           String        @unique // "EXPORT_PDF", "AI_SUMMARY", etc.
  name          String
  description   String?
  type          FeatureType   @default(BOOLEAN) // "boolean", "limit", "experiment"
  defaultConfig Json          @default("{}") // default values for experiment type
  isActive      Boolean       @default(true)
  planFeatures  PlanFeature[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum FeatureType {
  BOOLEAN
  LIMIT
  EXPERIMENT
}

model PlanFeature {
  id         String   @id @default(cuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId  String
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  enabled    Boolean  @default(false)
  limitValue Int? // null = unlimited (Enterprise)
  configJson Json     @default("{}") // experiment config, downgrade strategy
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([planId, featureId])
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  stripeCustomerId     String?               @unique
  stripeSubscriptionId String?
  subscription         Subscription?
  teamId               String?               @unique
  team                 Team?                 @relation(fields: [teamId], references: [id])
  entitlementOverrides EntitlementOverride[]
  usageTrackings       UsageTracking[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Subscription {
  id                 String             @id @default(cuid())
  orgId              String             @unique
  organization       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planKey            String // "free", "starter", "pro", "team"
  status             SubscriptionStatus @default(ACTIVE) // ACTIVE, TRIALING, PAST_DUE, CANCELED, UNPAID
  stripeSubId        String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

model EntitlementOverride {
  id         String        @id @default(cuid())
  scope      OverrideScope // "org" or "user"
  scopeId    String // orgId or userId
  featureKey String
  enabled    Boolean
  limitValue Int?
  expiresAt  DateTime?
  reason     String? // mandatory for admin-created overrides
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([scope, scopeId])
  @@index([scope, scopeId, featureKey])
}

enum OverrideScope {
  ORG
  USER
}

model UsageTracking {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  featureKey   String
  usageCount   Int          @default(0)
  periodStart  DateTime
  periodEnd    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([orgId, featureKey, periodStart])
  @@index([orgId, featureKey])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique // Stripe event ID
  type        String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Experiment {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  config      Json     @default("{}") // { percentage, seed, variantNames }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
