# Video Pipeline API Keys

# Deepgram - Speech-to-text transcription
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key

# Mux - Video processing and streaming
# Get your credentials at: https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# UploadThing - File uploads
# Get your keys at: https://uploadthing.com/dashboard
UPLOADTHING_SECRET=your_uploadthing_secret
UPLOADTHING_APP_ID=your_uploadthing_app_id

# Trigger.dev - Background job processing
TRIGGER_API_KEY=your_trigger_api_key
TRIGGER_API_URL=https://api.trigger.dev
