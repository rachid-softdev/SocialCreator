# ========================================
# SocialCreator Web - Environment Variables
# Copy to .env, .env.development, .env.local, etc.
# ========================================

# ========================================
# Auth & NextAuth
# ========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================
# OAuth Providers
# ========================================

# Google OAuth (Login + YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta OAuth (Instagram + Facebook + Threads)
# Docs: https://developers.facebook.com/docs/instagram-platform
META_CLIENT_ID=
META_CLIENT_SECRET=

# TikTok OAuth
# Docs: https://developers.tiktok.com/doc/content-posting-api
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn OAuth
# Docs: https://learn.microsoft.com/en-us/linkedin/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X (Twitter) OAuth
# Docs: https://developer.x.com/en/docs/twitter-api
X_CLIENT_ID=
X_CLIENT_SECRET=

# Pinterest OAuth
# Docs: https://developers.pinterest.com/docs/
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ========================================
# Database
# ========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialcreator

# ========================================
# AI & API Keys
# ========================================
ANTHROPIC_API_KEY=

# ========================================
# Payments (Stripe)
# ========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ========================================
# Media Processing
# ========================================
# Mux - Video processing and streaming
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Deepgram - Speech-to-text
DEEPGRAM_API_KEY=

# UploadThing - File uploads
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# ========================================
# Security
# ========================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ========================================
# Background Jobs (Trigger.dev)
# ========================================
# Docs: https://trigger.dev/docs
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_PUBLIC_KEY=
TRIGGER_PROJECT_ID=socialcreator

# ========================================
# Rate Limiting (Upstash Redis)
# ========================================
# Optional: pour rate limiting avancé
# Get free tier: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=