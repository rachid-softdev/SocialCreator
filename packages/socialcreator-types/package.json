{
  "name": "@socialcreator/types",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agent": {
      "import": "./dist/agent.js",
      "types": "./dist/agent.d.ts"
    },
    "./profile": {
      "import": "./dist/profile.js",
      "types": "./dist/profile.d.ts"
    },
    "./blog": {
      "import": "./dist/blog.js",
      "types": "./dist/blog.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@socialcreator/config": "workspace:*",
    "@types/node": "^22.13.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  }
}