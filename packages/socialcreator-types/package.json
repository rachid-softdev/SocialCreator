{
  "name": "@socialcreator/types",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./agent": {
      "import": "./dist/agent.mjs",
      "types": "./dist/agent.d.mts"
    },
    "./profile": {
      "import": "./dist/profile.mjs",
      "types": "./dist/profile.d.mts"
    },
    "./blog": {
      "import": "./dist/blog.mjs",
      "types": "./dist/blog.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@socialcreator/config": "workspace:*",
    "@types/node": "^22.13.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3",
    "vitest": "^1.0.0"
  }
}
