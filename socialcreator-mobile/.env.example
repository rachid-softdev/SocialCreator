# ========================================
# SocialCreator Mobile - Environment Variables
# Copy to .env, .env.development, .env.local, etc.
# ========================================

# ========================================
# App Configuration
# ========================================
APP_NAME=SocialCreator
APP_VERSION=1.0.0

# ========================================
# API Configuration
# ========================================
# Replace with your backend URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================
# Auth
# ========================================
AUTH_SECRET=  # Generate with: openssl rand -base64 32

# ========================================
# OAuth - These are handled by the backend
# Mobile uses deep links to authenticate
# ========================================
# Deep link scheme for OAuth callbacks
OAUTH_REDIRECT_SCHEME=socialcreator

# ========================================
# Storage
# ========================================
# For secure storage (react-native-keychain)
SECURE_STORAGE_KEY=

# ========================================
# Feature Flags
# ========================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CRASH_REPORTING=false