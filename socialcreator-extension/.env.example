# ========================================
# SocialCreator Extension - Environment Variables
# Copy to .env, .env.development, .env.local, etc.
# ========================================

# ========================================
# Extension Configuration
# ========================================
EXTENSION_NAME=SocialCreator
EXTENSION_VERSION=1.0.0

# ========================================
# Browser Extension Metadata
# ========================================
# These are typically set in manifest.json
# EXTENSION_ID=

# ========================================
# API Configuration
# ========================================
# Replace with your backend URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================
# Auth
# ========================================
AUTH_SECRET=  # Generate with: openssl rand -base64 32

# ========================================
# Extension-specific
# ========================================
# Enable extension features
NEXT_PUBLIC_EXTENSION_MODE=true

# Extension storage
# Extension uses chrome.storage.local / browser.storage.local

# ========================================
# Feature Flags
# ========================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false