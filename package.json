{
  "name": "@socialcreator/root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=socialcreator-web",
    "dev:all": "concurrently \"pnpm run dev\" \"pnpm run dev:scheduler\"",
    "build": "turbo build",
    "build:web": "turbo build --filter=socialcreator-web",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:run": "turbo test -- --run",
    "test:coverage": "turbo test -- --run --coverage",
    "test:e2e": "turbo test:e2e",
    "test:e2e:headed": "turbo test:e2e -- --headed",
    "test:e2e:ui": "turbo test:e2e -- --ui",
    "db:generate": "turbo db:generate",
    "db:seed": "pnpm --filter=socialcreator-web run db:seed",
    "clean": "turbo clean && rm -rf node_modules packages/*/node_modules",
    "web:dev": "pnpm --filter=socialcreator-web dev",
    "web:build": "pnpm --filter=socialcreator-web build",
    "web:start": "pnpm --filter=socialcreator-web start",
    "web:test": "pnpm --filter=socialcreator-web test",
    "web:lint": "pnpm --filter=socialcreator-web lint",
    "web:typecheck": "pnpm --filter=socialcreator-web typecheck",
    "desktop:dev": "pnpm --filter=socialcreator-desktop dev",
    "desktop:build": "pnpm --filter=socialcreator-desktop build",
    "desktop:test": "pnpm --filter=socialcreator-desktop test",
    "desktop:lint": "pnpm --filter=socialcreator-desktop lint",
    "desktop:typecheck": "pnpm --filter=socialcreator-desktop typecheck",
    "mobile:dev": "pnpm --filter=socialcreator-mobile dev",
    "mobile:build": "pnpm --filter=socialcreator-mobile build",
    "mobile:test": "pnpm --filter=socialcreator-mobile test",
    "mobile:lint": "pnpm --filter=socialcreator-mobile lint",
    "mobile:typecheck": "pnpm --filter=socialcreator-mobile typecheck",
    "extension:dev": "pnpm --filter=socialcreator-extension dev",
    "extension:build": "pnpm --filter=socialcreator-extension build",
    "extension:test": "pnpm --filter=socialcreator-extension test",
    "extension:lint": "pnpm --filter=socialcreator-extension lint",
    "extension:typecheck": "pnpm --filter=socialcreator-extension typecheck",
    "check-env": "pnpm --filter=socialcreator-web check-env",
    "push-env": "pnpm --filter=socialcreator-web push-env"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.1.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.9"
}
