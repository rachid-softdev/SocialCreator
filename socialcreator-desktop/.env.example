# ========================================
# SocialCreator Desktop - Environment Variables
# Copy to .env, .env.development, .env.local, etc.
# ========================================

# ========================================
# App Configuration
# ========================================
APP_NAME=SocialCreator
APP_VERSION=1.0.0

# ========================================
# Desktop App Metadata
# ========================================
# These are typically set by electron-builder/tauri
# APP_ID=com.socialcreator.desktop
# PRODUCT_NAME=SocialCreator

# ========================================
# API Configuration
# ========================================
# Replace with your backend URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================
# Auth
# ========================================
AUTH_SECRET=  # Generate with: openssl rand -base64 32

# ========================================
# Desktop-specific
# ========================================
# Enable desktop features
NEXT_PUBLIC_DESKTOP_MODE=true

# Local storage path (optional override)
# LOCAL_DATA_PATH=

# ========================================
# Feature Flags
# ========================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CRASH_REPORTING=false